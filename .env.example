# Canonical origin. No trailing slash. Configure separately for each deployment.
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Google callback: http://localhost:3000/api/auth/callback/google
# Neon provisioned from Vercel Marketplace. POSTGRES_URL is also accepted.
DATABASE_URL=
# PRIVATE Vercel Blob store, dedicated to this app.
BLOB_READ_WRITE_TOKEN=
# Stripe test keys only until GPU quality, delivery and commercial launch are validated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# openssl rand -hex 32. Used for maintenance via Vercel Cron.
CRON_SECRET=

# Enable only after commissioning the GPU worker; never silently fall back to simulated 3D.
RECONSTRUCTION_ENABLED=false
RECONSTRUCTION_WORKER_SECRET=
RECONSTRUCTION_MIN_IMAGES=20
